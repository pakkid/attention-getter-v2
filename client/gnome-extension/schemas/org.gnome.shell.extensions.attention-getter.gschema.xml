<?xml version="1.0" encoding="UTF-8"?>
<schemalist>
  <schema id="org.gnome.shell.extensions.attention-getter" path="/org/gnome/shell/extensions/attention-getter/">
    <key name="focus-key" type="as">
      <!-- F13 is often delivered as XF86Tools by the default keymap; 0xbf is the F13 key's
           keycode, which wins over other XF86Tools bindings (see gnome_accels in install.rs). -->
      <default><![CDATA[['F13', '0xbf', 'XF86Tools']]]></default>
      <summary>Focus the attention popup</summary>
    </key>
  </schema>
</schemalist>
