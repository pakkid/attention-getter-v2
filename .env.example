# Public HTTPS URL of the server (your Cloudflare Tunnel hostname).
PUBLIC_URL=https://attention.example.com

# OAuth 2.0 Client ID (type "Web application") from Google Cloud Console.
# Authorized JavaScript origins must include PUBLIC_URL.
GOOGLE_CLIENT_ID=1234567890-abc.apps.googleusercontent.com

# Comma-separated Google accounts that are admins. Admins add everyone else in the web app.
ADMIN_EMAILS=you@gmail.com

# Optional: VAPID contact for Web Push (defaults to PUBLIC_URL). Use mailto:you@example.com or an https URL.
# VAPID_SUBJECT=
